{
  "opacity": {
    "50": { "$value": 0.05, "$type": "number" },
    "100": { "$value": 0.1, "$type": "number" },
    "200": { "$value": 0.2, "$type": "number" },
    "300": { "$value": 0.3, "$type": "number" },
    "400": { "$value": 0.4, "$type": "number" },
    "500": { "$value": 0.5, "$type": "number" },
    "600": { "$value": 0.6, "$type": "number" },
    "700": { "$value": 0.7, "$type": "number" },
    "800": { "$value": 0.8, "$type": "number" },
    "900": { "$value": 0.9, "$type": "number" },
    "1000": { "$value": 1, "$type": "number" },
    "interactive": {
      "selected-bg": {
        "$value": "{opacity.400}",
        "$type": "number"
      }
    },
    "surface": {
      "primary": {
        "$value": "{opacity.900}",
        "$type": "number"
      },
      "overlay": {
        "$value": "{opacity.400}",
        "$type": "number"
      },
      "subtle": {
        "$value": "{opacity.200}",
        "$type": "number"
      },
      "ghost": {
        "$value": "{opacity.100}",
        "$type": "number"
      }
    },
    "text": {
      "secondary": {
        "$value": "{opacity.600}",
        "$type": "number"
      },
      "disabled": {
        "$value": "{opacity.400}",
        "$type": "number"
      }
    }
  }
}
